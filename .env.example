# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Canonical production URL used by metadata, robots.txt, sitemap.xml and JSON-LD.
SITE_URL="https://example.com"

# Better Auth
BETTER_AUTH_SECRET="generate-a-random-32-char-secret-here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Google OAuth. In Google Cloud Console add this callback URL:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated hostnames only. Keep empty when all product images are local/data URLs.
IMAGE_REMOTE_HOSTS=""

# Add only when a trusted reverse proxy/CDN makes the forwarded host differ from the app host.
SERVER_ACTION_ALLOWED_ORIGINS=""

# Header set and overwritten by your trusted CDN. Example for Cloudflare: cf-connecting-ip
TRUSTED_IP_HEADER=""

# Transactional email used by the password-reset flow.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Chayapon Works <no-reply@example.com>"

# Optional: Admin account for seed script
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Server-only fallback values used before an Admin saves Store Settings.
LINE_URL=""
PROMPTPAY_ID=""

# Use a long random value in production. BETTER_AUTH_SECRET is used as a
# compatibility fallback when this value is omitted.
STORE_SETTINGS_ENCRYPTION_KEY=""
